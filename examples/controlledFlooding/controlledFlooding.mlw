(* ============================================================
   Controlled flooding.

   Contribution by: Gonçalo Caixeiro

   Adapted to the why3do refinement framework.

   A message originating at a single source node is propagated across a
   network.  A node holding the message may pass it to a neighbour that
   does not yet hold it; a node is never told twice.  This is the
   "controlled" part: the guard is the recipient's own record of whether
   it already has the message, so the flood cannot circulate for ever.

   Topology   node = int, valid below n_nodes; an uninterpreted edge
              relation, assumed only to relate valid nodes; a source node
              and a message value source_msg

   State      received  the set of nodes holding the message
              content   what each node holds

   Action     flood u v  u passes the message to a neighbour v that does
                         not yet hold it

   Invariant  the source holds the message; every node holding the
              message is valid and holds exactly source_msg

   Results over reachable states
     - safety: an informed node holds source_msg, and the source is
       always informed
     - cardinal received <= n_nodes (cardinal_bounded, from member
       validity via bound_cardinal, rather than an invariant conjunct)
     - monotonicity: the set of informed nodes never shrinks, and an
       informed node's content never changes
     - termination: every step strictly decreases n_nodes - cardinal
       received, which stays non-negative, so flooding stops after at
       most n_nodes steps
     - completeness: in a quiescent state every node with a path from
       the source is informed; with a connected topology that is every
       valid node

   Assumptions.  Four axioms, all well-formedness conditions on an
   otherwise uninterpreted topology: n_nodes > 0, source is valid, and
   edges relate valid nodes.  Path length is carried by the inductive
   relation path_len rather than by an axiomatised distance function, so
   completeness is proved by induction on the derivation.

   Limitations
     - Transmission is atomic and reliable.  Passing the message is one
       step: no channel, no message in flight, no loss, duplication,
       reordering or delay, and no distinction between sending and
       receiving.  Nodes do not fail.
     - The edge relation is not assumed symmetric, so "connected" means
       every node is reachable from the source along directed edges, not
       mutual reachability.  Nothing rules out an empty topology, in
       which case coverage holds for the source alone.
     - Only one flood is modelled.  content can only ever hold
       source_msg, so nothing distinguishes a stale message from a fresh
       one; sequence numbers, hop counts and time-to-live are absent, and
       a second flood of a different message is out of scope.
     - Completeness is conditional on quiescence.  Termination shows the
       process cannot run for ever, but no run is constructed, so the
       existence of a reachable quiescent state is not itself proved.
     - No fairness or timing.  Nothing bounds how long a node waits
       before forwarding, and no liveness property is stated.
   ============================================================ *)


module ControlledFlooding

  use int.Int
  use set.Fset
  use map.Map

  (* ---------------------------------------------------------------- *)
  (* Network                                                          *)
  (* ---------------------------------------------------------------- *)

  type node = int

  val constant n_nodes : int
  axiom n_nodes_pos : n_nodes > 0

  predicate valid_node (n: node) = 0 <= n < n_nodes

  val predicate edge (u v: node)

  axiom edge_src_valid : forall u v: node. edge u v -> valid_node u
  axiom edge_dst_valid : forall u v: node. edge u v -> valid_node v

  type msg

  val constant source_msg : msg

  val constant source : node
  axiom source_valid : valid_node source

  (* ---------------------------------------------------------------- *)
  (* State                                                            *)
  (* ---------------------------------------------------------------- *)

  type world = {
    received : fset node;
    content  : map node msg;
  }

  (* ---------------------------------------------------------------- *)
  (* A set of nodes drawn from 0 .. k-1 has at most k elements.        *)
  (* Used to bound cardinal received, both initially and after a       *)
  (* flood; available to the provers as an ordinary lemma.             *)
  (* ---------------------------------------------------------------- *)

  let rec ghost lemma bound_cardinal (s: fset node) (k: int)
    requires { 0 <= k }
    requires { forall n: node. mem n s -> 0 <= n < k }
    variant  { k }
    ensures  { cardinal s <= k }
  = if k = 0 then begin
      assert { forall n: node. not (mem n s) };
      assert { s = empty }
    end else
      bound_cardinal (remove (k - 1) s) (k - 1)

  (* ---------------------------------------------------------------- *)
  (* Inductive invariant                                              *)
  (* ---------------------------------------------------------------- *)

  predicate inv (w: world) =
    mem source w.received /\
    w.content[source] = source_msg /\
    (forall n: node. mem n w.received -> valid_node n) /\
    (forall n: node. mem n w.received -> w.content[n] = source_msg)

  let lemma cardinal_bounded (w: world)
    requires { inv w }
    ensures  { cardinal w.received <= n_nodes }
  = bound_cardinal w.received n_nodes


  predicate initWorld_p (w: world) =
    w.received = singleton source /\
    w.content[source] = source_msg

  let ghost predicate initWorld (w: world)
    ensures { result -> inv w }
  = initWorld_p w

  (* ---------------------------------------------------------------- *)
  (* The flooding step                                                *)
  (* ---------------------------------------------------------------- *)

  predicate can_flood (w: world) (u v: node) =
    mem u w.received /\ edge u v /\ not mem v w.received

  (* flood is total on its guard: it does not require inv.  Keeping it
     total is what lets the step relation be inverted, so that invariant
     preservation and the cardinality increase are proved rather than
     assumed. *)
  let ghost function flood (w: world) (u v: node) : world
    requires { can_flood w u v }
    ensures  { result.received = add v w.received }
    ensures  { cardinal result.received = cardinal w.received + 1 }
    ensures  { result.content[v] = w.content[u] }
    ensures  { forall n: node. mem n w.received ->
                 result.content[n] = w.content[n] }
  =
    { received = add v w.received;
      content  = w.content[v <- w.content[u]] }

  let rec ghost lemma flood_preserves_inv (w: world) (u v: node)
    requires { can_flood w u v }
    requires { inv w }
    ensures  { inv (flood w u v) }
    variant  { cardinal w.received }
  =
    ()

  inductive stepind world world =
    | step_flood : forall w: world, u v: node.
        can_flood w u v -> stepind w (flood w u v)

  let ghost predicate step (w1: world) (w2: world)
    ensures { result -> inv w1 -> inv w2 }
  = stepind w1 w2

  clone export inductiveness.Inductiveness with
    type world          = world,
    predicate inv       = inv,
    val initWorld       = initWorld,
    val step            = step

  (* ---------------------------------------------------------------- *)
  (* Properties of the transitive closure                             *)
  (*                                                                  *)
  (* Each of these is proved by induction on the step_TR derivation    *)
  (* (transformation induction_pr), with the single-step case coming   *)
  (* from flood's postconditions.  No fuel measure and no auxiliary    *)
  (* axioms are needed.                                               *)
  (* ---------------------------------------------------------------- *)

  lemma inv_step_TR :
    forall wa wb: world. inv wa -> step_TR wa wb -> inv wb

  lemma received_monotone_TR :
    forall wa wb: world. step_TR wa wb ->
      forall n: node. mem n wa.received -> mem n wb.received

  lemma content_stable_TR :
    forall wa wb: world. inv wa -> step_TR wa wb ->
      forall n: node. mem n wa.received ->
        wb.content[n] = wa.content[n]

  (* ---------------------------------------------------------------- *)
  (* Paths                                                            *)
  (*                                                                  *)
  (* path_len carries the length, so completeness can be proved by     *)
  (* induction on the derivation.  This replaces an uninterpreted      *)
  (* path_length function with five axioms and a choice function for   *)
  (* path predecessors.                                                *)
  (* ---------------------------------------------------------------- *)

  inductive path_len node node int =
    | pl_refl : forall n: node. path_len n n 0
    | pl_step : forall u v z: node, k: int.
        path_len u v k -> edge v z -> path_len u z (k + 1)

  lemma path_len_nonneg :
    forall u v: node, k: int. path_len u v k -> 0 <= k

  predicate path (u v: node) =
    exists k: int. path_len u v k

  (* ---------------------------------------------------------------- *)
  (* Quiescence and completeness                                      *)
  (* ---------------------------------------------------------------- *)

  predicate quiescent (w: world) =
    forall u v: node. not (can_flood w u v)

  (* By induction on path_len: at a quiescent state, an informed node's
     neighbours are all informed, since otherwise a flood would be
     enabled. *)
  lemma flood_reaches :
    forall u v: node, k: int. path_len u v k ->
      forall w: world.
        inv w -> quiescent w -> mem u w.received ->
        mem v w.received

  predicate connected =
    forall v: node. valid_node v -> path source v

  (* ---------------------------------------------------------------- *)
  (* Safety, termination and coverage                                 *)
  (* ---------------------------------------------------------------- *)

  goal informedNodesHoldSourceMsg :
    forall w: world, n: node. reachable w ->
      mem n w.received -> w.content[n] = source_msg

  goal sourceAlwaysInformed :
    forall w: world. reachable w -> mem source w.received

  goal informedNodesAreValid :
    forall w: world, n: node. reachable w ->
      mem n w.received -> valid_node n

  (* Every step strictly decreases n_nodes - cardinal received, which is
     non-negative, so flooding stops after at most n_nodes steps. *)
  goal flood_terminates :
    forall w1 w2: world. reachable w1 -> step w1 w2 ->
      0 <= n_nodes - cardinal w2.received
      < n_nodes - cardinal w1.received

  (* The initial state is not quiescent whenever the source has a
     neighbour, so the quiescence hypothesis below is not reached
     trivially. *)
  goal sourceCanFlood :
    forall w: world, v: node.
      initWorld w -> edge source v -> v <> source ->
      can_flood w source v

  goal completeness :
    forall w: world. reachable w -> quiescent w ->
      forall v: node. path source v ->
        mem v w.received /\ w.content[v] = source_msg

  goal full_coverage :
    connected ->
    forall w: world. reachable w -> quiescent w ->
      forall v: node. valid_node v ->
        mem v w.received /\ w.content[v] = source_msg

end
