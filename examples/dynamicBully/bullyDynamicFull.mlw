(* Full dynamic Bully model.

   Contribution by:
     João Gonçalves, Carlos Pina

   Compared with the initial Bully model, this version adds:
     - dynamic failures: alive is part of the world;
     - recovery, conservatively restricted when a lower leader already exists;
     - per-process inboxes instead of one global network list;
     - message consumption when a message is received;
     - abstract failure detection through suspicion;
     - heartbeat messages;
     - local progress properties for recovery after leader failure;
     - refinement to LeaderElectMaxAliveDynamicFull and then to
       LeaderElectDynamicFull.

   This file is intentionally ambitious.  It is meant as a strong next version
   of the project, not as a minimal extension.
*)

module BullyDynamicFull

  use int.Int
  use map.Map
  use list.List
  use list.Mem

  use leaderElectDynamicFull.LeaderElectDynamicFull
  use leaderElectMaxAliveDynamicFull.LeaderElectMaxAliveDynamicFull

  type status =
    | Idle
    | Electing
    | Waiting
    | Normal
    | Crashed

  type msg_kind =
    | Election
    | Ok
    | Coordinator
    | Heartbeat

  type packet = {
    src  : node;
    dst  : node;
    kind : msg_kind
  }

  type world = {
    st      : map node status;
    alive   : map node bool;
    leader  : map node bool;
    inbox   : map node (list packet);
    suspect : map node bool;
  }

  let function refn (w:world) : LeaderElectMaxAliveDynamicFull.world =
    { aliveMax = w.alive; isMaxAlive = w.leader }

  let function fullrefn (w:world) : LeaderElectDynamicFull.world =
    LeaderElectMaxAliveDynamicFull.refn (refn w)

  predicate is_max_alive (w:world) (h:node) =
    valid h /\ w.alive[h] /\
    forall k : node. valid k -> w.alive[k] -> id k <= id h

  predicate no_alive_higher (w:world) (h:node) =
    valid h /\ w.alive[h] /\
    forall k : node. valid k -> w.alive[k] -> not (id h < id k)

  lemma no_alive_higher_is_max :
    forall w : world, h : node.
      no_alive_higher w h -> is_max_alive w h

  (* se h é o maior vivo no estado atual, então não há vivo com ID maior *)
  lemma is_max_alive_no_alive_higher :
    forall w : world, h : node.
      is_max_alive w h -> no_alive_higher w h

  (* junta os dois sentidos: ser maior vivo equivale a não existir vivo com ID maior *)
  lemma is_max_alive_equiv_no_alive_higher :
    forall w : world, h : node.
      is_max_alive w h <-> no_alive_higher w h

  predicate no_leader (w:world) =
    forall n : node. valid n -> not w.leader[n]

  predicate some_alive (w:world) =
    exists n : node. valid n /\ w.alive[n]

  let function same_kind (a:msg_kind) (b:msg_kind) : bool =
    match a with
    | Election ->
        match b with | Election -> true | _ -> false end
    | Ok ->
        match b with | Ok -> true | _ -> false end
    | Coordinator ->
        match b with | Coordinator -> true | _ -> false end
    | Heartbeat ->
        match b with | Heartbeat -> true | _ -> false end
    end

  let function same_packet (p:packet) (q:packet) : bool =
    p.src = q.src && p.dst = q.dst && same_kind p.kind q.kind

  (* remove exactly one occurrence of a packet from a list, if present.
     We use a Boolean function instead of a logical predicate, because this
     function is used in an executable/ghost-program expression. *)
  let rec function remove_packet (p:packet) (l:list packet) : list packet
    variant { l }
  = match l with
    | Nil -> Nil
    | Cons q r -> if same_packet q p then r else Cons q (remove_packet p r)
    end

  (* se uma mensagem aparece depois de remover outra da lista, então já aparecia na lista original *)
  let rec lemma mem_remove_packet (p q : packet) (l : list packet)
    ensures { mem q (remove_packet p l) -> mem q l }
    variant { l }
  =
    match l with
    | Nil -> ()
    | Cons x r ->
        if same_packet x p then ()
        else mem_remove_packet p q r
    end

  let ghost function add_msg (ib:map node (list packet)) (d:node) (p:packet)
    : map node (list packet) =
    ib[d <- Cons p ib[d]]

  (* Structural validity of messages.  This intentionally does not require
     src/dst to be alive in the current state, because a process may crash
     after sending a message.  Receive guards decide which stale messages may
     actually be consumed. *)
  predicate ok_packet (p:packet) =
    valid p.src /\ valid p.dst /\
    match p.kind with
    | Election -> id p.src < id p.dst
    | Ok -> id p.dst < id p.src
    | Coordinator -> id p.dst < id p.src
    | Heartbeat -> p.dst <> p.src
    end

  (* uma mensagem Election é bem formada quando sobe para um ID maior *)
  lemma ok_packet_election :
    forall h d : node.
      valid h -> valid d -> id h < id d ->
      ok_packet { src = h; dst = d; kind = Election }

  (* uma mensagem Ok é bem formada quando vem de um ID maior para um ID menor *)
  lemma ok_packet_ok :
    forall h d : node.
      valid h -> valid d -> id d < id h ->
      ok_packet { src = h; dst = d; kind = Ok }

  (* uma mensagem Coordinator é bem formada quando vem de um ID maior para um ID menor *)
  lemma ok_packet_coordinator :
    forall h d : node.
      valid h -> valid d -> id d < id h ->
      ok_packet { src = h; dst = d; kind = Coordinator }

  (* uma mensagem Heartbeat é bem formada quando emissor e destinatário são válidos e diferentes *)
  lemma ok_packet_heartbeat :
    forall h d : node.
      valid h -> valid d -> h <> d ->
      ok_packet { src = h; dst = d; kind = Heartbeat }

  predicate all_inbox_ok (w:world) =
    forall n : node, p : packet.
      valid n -> mem p w.inbox[n] -> ok_packet p

  (* se vejo a inbox do destinatário depois de add_msg, a mensagem pode ser a nova ou uma antiga *)
  lemma mem_add_msg_same :
    forall ib : map node (list packet), d : node, p q : packet.
      mem q (add_msg ib d p)[d] -> q = p \/ mem q ib[d]

  (* se vejo a inbox de outro processo depois de add_msg, ela não mudou *)
  lemma mem_add_msg_other :
    forall ib : map node (list packet), d n : node, p q : packet.
      n <> d ->
      mem q (add_msg ib d p)[n] ->
      mem q ib[n]

  (* se adiciono uma mensagem bem formada a uma inbox bem formada, todas as inboxes continuam bem formadas *)
  lemma all_inbox_ok_add_msg :
    forall w : world, d : node, p : packet.
      valid d ->
      all_inbox_ok w ->
      ok_packet p ->
      all_inbox_ok { w with inbox = add_msg w.inbox d p }

  (* se removo uma mensagem de uma inbox bem formada, todas as mensagens que ficam continuam bem formadas *)
  lemma all_inbox_ok_remove_packet_at :
    forall w : world, h : node, p : packet.
      valid h ->
      all_inbox_ok w ->
      all_inbox_ok { w with inbox = w.inbox[h <- remove_packet p w.inbox[h]] }

  (* se removo uma mensagem e depois adiciono uma nova bem formada, as inboxes continuam bem formadas *)
  lemma all_inbox_ok_remove_then_add :
    forall w : world, h d : node, oldp newp : packet.
      valid h ->
      valid d ->
      all_inbox_ok w ->
      ok_packet newp ->
      all_inbox_ok {
        w with inbox =
          add_msg (w.inbox[h <- remove_packet oldp w.inbox[h]]) d newp
      }

  predicate inv (w:world) =
    (* any concrete leader is alive and is the current max alive process *)
    (forall i : node.
       valid i -> w.leader[i] -> is_max_alive w i)
    /\
    (* at most one leader *)
    (forall i j : node.
       valid i -> valid j -> w.leader[i] -> w.leader[j] -> i = j)
    /\
    (* crashed processes are not leaders and are not suspicious/electing *)
    (forall i : node.
       valid i -> not w.alive[i] ->
         not w.leader[i] /\ not w.suspect[i] /\ w.st[i] = Crashed)
    /\
    (* every message currently queued in any inbox is well-formed *)
    all_inbox_ok w

  predicate initWorld_p (w:world) =
    (forall n : node. valid n -> w.st[n] = Idle)
    /\
    (forall n : node. valid n -> w.alive[n] = true)
    /\
    (forall n : node. valid n -> w.leader[n] = false)
    /\
    (forall n : node. valid n -> w.suspect[n] = false)
    /\
    (forall n : node. valid n -> w.inbox[n] = Nil)

  let ghost predicate initWorld (w:world)
    ensures { result -> inv w }
    ensures { result -> LeaderElectMaxAliveDynamicFull.initWorld (refn w) }
  = initWorld_p w

  (* Dynamic failure.  If the crashed process was leader, it stops being leader.
     Its own inbox is discarded, but old messages already sent to others may
     remain queued as stale messages. *)
  predicate crash_enbld (w:world) (h:node) =
    valid h /\ w.alive[h]

  let ghost function crash (w:world) (h:node) : world
    requires { crash_enbld w h }
    ensures  { inv w -> inv result }
    ensures  { inv w -> LeaderElectMaxAliveDynamicFull.stepind (refn w) (refn result) }
  =
    { st      = w.st[h <- Crashed];
      alive   = w.alive[h <- false];
      leader  = w.leader[h <- false];
      inbox   = w.inbox[h <- Nil];
      suspect = w.suspect[h <- false] }

  (* Conservative recovery.  If a leader exists, the recovered process must have
     a lower ID than that leader, otherwise the current leader would no longer be
     max-alive.  If there is no leader, recovery is always allowed. *)
  predicate recover_enbld (w:world) (h:node) =
    valid h /\ not w.alive[h] /\
    (forall l : node. valid l -> w.leader[l] -> id h < id l)

  let ghost function recover (w:world) (h:node) : world
    requires { recover_enbld w h }
    ensures  { inv w -> inv result }
    ensures  { inv w -> LeaderElectMaxAliveDynamicFull.stepind (refn w) (refn result) }
  =
    { st      = w.st[h <- Idle];
      alive   = w.alive[h <- true];
      leader  = w.leader;
      inbox   = w.inbox[h <- Nil];
      suspect = w.suspect[h <- no_leader w] }

  (* se outro processo já era líder antes do crash, continua a ser o maior vivo depois do crash *)
  lemma leader_still_max_after_crash_other :
    forall w : world, h l : node.
      inv w ->
      crash_enbld w h ->
      valid l ->
      w.leader[l] ->
      l <> h ->
      is_max_alive (crash w h) l

  (* se um processo recupera respeitando a guarda de recover, o líder antigo continua a ser o maior vivo *)
  lemma leader_still_max_after_recover :
    forall w : world, h l : node.
      inv w ->
      recover_enbld w h ->
      valid l ->
      w.leader[l] ->
      is_max_alive (recover w h) l

  (* Abstract timeout/failure detector.  If there is no leader, an alive process
     may suspect that coordination is missing and start an election. *)
  predicate timeout_suspect_enbld (w:world) (h:node) =
    valid h /\ w.alive[h] /\ not w.leader[h] /\ no_leader w

  let ghost function timeout_suspect (w:world) (h:node) : world
    requires { timeout_suspect_enbld w h }
    ensures  { inv w -> inv result }
    ensures  { refn result = refn w }
  =
    { st      = w.st;
      alive   = w.alive;
      leader  = w.leader;
      inbox   = w.inbox;
      suspect = w.suspect[h <- true] }

  predicate start_election_enbld (w:world) (h:node) =
    valid h /\ w.alive[h] /\ w.suspect[h] /\
    (w.st[h] = Idle \/ w.st[h] = Normal \/ w.st[h] = Waiting)

  let ghost function start_election (w:world) (h:node) : world
    requires { start_election_enbld w h }
    ensures  { inv w -> inv result }
    ensures  { refn result = refn w }
  =
    { st      = w.st[h <- Electing];
      alive   = w.alive;
      leader  = w.leader;
      inbox   = w.inbox;
      suspect = w.suspect[h <- false] }

  predicate send_election_enbld (w:world) (h d:node) =
    valid h /\ valid d /\ w.alive[h] /\ w.alive[d] /\
    w.st[h] = Electing /\ id h < id d

  let ghost function send_election (w:world) (h d:node) : world
    requires { send_election_enbld w h d }
    ensures  { inv w -> inv result }
    ensures  { refn result = refn w }
  =
    let p = { src = h; dst = d; kind = Election } in
    { st      = w.st;
      alive   = w.alive;
      leader  = w.leader;
      inbox   = add_msg w.inbox d p;
      suspect = w.suspect }

  predicate recv_election_enbld (w:world) (h:node) (p:packet) =
    valid h /\ w.alive[h] /\
    mem p w.inbox[h] /\
    p.dst = h /\ p.kind = Election /\ id p.src < id h

  let ghost function recv_election (w:world) (h:node) (p:packet) : world
    requires { recv_election_enbld w h p }
    ensures  { inv w -> inv result }
    ensures  { refn result = refn w }
  =
    let ib1 = w.inbox[h <- remove_packet p w.inbox[h]] in
    let reply = { src = h; dst = p.src; kind = Ok } in
    { st      = w.st[h <- Electing];
      alive   = w.alive;
      leader  = w.leader;
      inbox   = add_msg ib1 p.src reply;
      suspect = w.suspect }

  predicate recv_ok_enbld (w:world) (h:node) (p:packet) =
    valid h /\ w.alive[h] /\
    mem p w.inbox[h] /\
    p.dst = h /\ p.kind = Ok /\ id h < id p.src

  let ghost function recv_ok (w:world) (h:node) (p:packet) : world
    requires { recv_ok_enbld w h p }
    ensures  { inv w -> inv result }
    ensures  { refn result = refn w }
  =
    { st      = w.st[h <- Waiting];
      alive   = w.alive;
      leader  = w.leader;
      inbox   = w.inbox[h <- remove_packet p w.inbox[h]];
      suspect = w.suspect }

  predicate become_leader_enbld (w:world) (h:node) =
    valid h /\ w.alive[h] /\
    w.st[h] = Electing /\
    no_alive_higher w h /\
    no_leader w

  let ghost function become_leader (w:world) (h:node) : world
    requires { become_leader_enbld w h }
    ensures  { inv w -> inv result }
    ensures  { inv w -> LeaderElectMaxAliveDynamicFull.stepind (refn w) (refn result) }
  =
    { st      = w.st[h <- Normal];
      alive   = w.alive;
      leader  = w.leader[h <- true];
      inbox   = w.inbox;
      suspect = w.suspect[h <- false] }

  predicate send_coord_enbld (w:world) (h d:node) =
    valid h /\ valid d /\ w.alive[h] /\ w.alive[d] /\
    w.leader[h] /\ id d < id h

  let ghost function send_coord (w:world) (h d:node) : world
    requires { send_coord_enbld w h d }
    ensures  { inv w -> inv result }
    ensures  { refn result = refn w }
  =
    let p = { src = h; dst = d; kind = Coordinator } in
    { st      = w.st;
      alive   = w.alive;
      leader  = w.leader;
      inbox   = add_msg w.inbox d p;
      suspect = w.suspect }

  predicate recv_coord_enbld (w:world) (h:node) (p:packet) =
    valid h /\ w.alive[h] /\
    mem p w.inbox[h] /\
    p.dst = h /\ p.kind = Coordinator /\
    w.alive[p.src] /\ w.leader[p.src]

  let ghost function recv_coord (w:world) (h:node) (p:packet) : world
    requires { recv_coord_enbld w h p }
    ensures  { inv w -> inv result }
    ensures  { refn result = refn w }
  =
    { st      = w.st[h <- Normal];
      alive   = w.alive;
      leader  = w.leader;
      inbox   = w.inbox[h <- remove_packet p w.inbox[h]];
      suspect = w.suspect[h <- false] }

  predicate send_heartbeat_enbld (w:world) (h d:node) =
    valid h /\ valid d /\ h <> d /\
    w.alive[h] /\ w.alive[d] /\ w.leader[h]

  let ghost function send_heartbeat (w:world) (h d:node) : world
    requires { send_heartbeat_enbld w h d }
    ensures  { inv w -> inv result }
    ensures  { refn result = refn w }
  =
    let p = { src = h; dst = d; kind = Heartbeat } in
    { st      = w.st;
      alive   = w.alive;
      leader  = w.leader;
      inbox   = add_msg w.inbox d p;
      suspect = w.suspect }

  predicate recv_heartbeat_enbld (w:world) (h:node) (p:packet) =
    valid h /\ w.alive[h] /\
    mem p w.inbox[h] /\
    p.dst = h /\ p.kind = Heartbeat /\
    w.alive[p.src] /\ w.leader[p.src]

  let ghost function recv_heartbeat (w:world) (h:node) (p:packet) : world
    requires { recv_heartbeat_enbld w h p }
    ensures  { inv w -> inv result }
    ensures  { refn result = refn w }
  =
    { st      = w.st[h <- Normal];
      alive   = w.alive;
      leader  = w.leader;
      inbox   = w.inbox[h <- remove_packet p w.inbox[h]];
      suspect = w.suspect[h <- false] }

  inductive stepind world world =
  | step_crash : forall w : world, h : node.
      crash_enbld w h -> stepind w (crash w h)
  | step_recover : forall w : world, h : node.
      recover_enbld w h -> stepind w (recover w h)
  | step_timeout : forall w : world, h : node.
      timeout_suspect_enbld w h -> stepind w (timeout_suspect w h)
  | step_start : forall w : world, h : node.
      start_election_enbld w h -> stepind w (start_election w h)
  | step_send_election : forall w : world, h d : node.
      send_election_enbld w h d -> stepind w (send_election w h d)
  | step_recv_election : forall w : world, h : node, p : packet.
      recv_election_enbld w h p -> stepind w (recv_election w h p)
  | step_recv_ok : forall w : world, h : node, p : packet.
      recv_ok_enbld w h p -> stepind w (recv_ok w h p)
  | step_become_leader : forall w : world, h : node.
      become_leader_enbld w h -> stepind w (become_leader w h)
  | step_send_coord : forall w : world, h d : node.
      send_coord_enbld w h d -> stepind w (send_coord w h d)
  | step_recv_coord : forall w : world, h : node, p : packet.
      recv_coord_enbld w h p -> stepind w (recv_coord w h p)
  | step_send_heartbeat : forall w : world, h d : node.
      send_heartbeat_enbld w h d -> stepind w (send_heartbeat w h d)
  | step_recv_heartbeat : forall w : world, h : node, p : packet.
      recv_heartbeat_enbld w h p -> stepind w (recv_heartbeat w h p)

  let ghost predicate step (w1:world) (w2:world)
    ensures { result -> inv w1 -> inv w2 }
    ensures { result -> inv w1 -> refn w1 = refn w2
                              \/ LeaderElectMaxAliveDynamicFull.step (refn w1) (refn w2) }
  = stepind w1 w2

  clone inductiveness.Inductiveness with
    type world = world,
    predicate inv = inv,
    val initWorld = initWorld,
    val step = step

  clone refinement.Refinement with
    type worldC = world,
    type worldA = LeaderElectMaxAliveDynamicFull.world,
    val refn = refn,
    predicate invC = inv,
    predicate invA = LeaderElectMaxAliveDynamicFull.inv,
    val initWorldC = initWorld,
    val initWorldA = LeaderElectMaxAliveDynamicFull.initWorld,
    val stepC = step,
    val stepA = LeaderElectMaxAliveDynamicFull.step

  goal leaderIsAlive :
    forall w : world, i : node.
      reachableC w -> valid i -> w.leader[i] -> w.alive[i]

  goal leaderIsMaxAlive :
    forall w : world, i : node.
      reachableC w -> valid i -> w.leader[i] -> is_max_alive w i

  goal uniqueLeader :
    forall w : world, i j : node.
      reachableC w -> valid i -> valid j ->
      w.leader[i] -> w.leader[j] -> i = j

  goal uniqueLeader_AbstractView :
    forall w : world, i j : node.
      reachableC w -> valid i -> valid j ->
      (fullrefn w).isLeader[i] -> (fullrefn w).isLeader[j] -> i = j

  goal allInboxMessagesWellFormed :
    forall w : world, n : node, p : packet.
      reachableC w -> valid n -> mem p w.inbox[n] -> ok_packet p

  goal crashedProcessIsNotLeader :
    forall w : world, h : node.
      crash_enbld w h -> not (crash w h).leader[h]

  (* se h é líder num estado válido, então nenhum outro processo diferente de h é líder *)
  lemma leader_unique_against_h :
    forall w : world, h n : node.
      inv w ->
      valid h ->
      valid n ->
      w.leader[h] ->
      n <> h ->
      not w.leader[n]

   (* se h era líder num estado válido, então depois de crash nenhum processo fica líder *)
  let lemma crash_removes_all_leaders (w:world) (h n:node)
    requires { inv w }
    requires { crash_enbld w h }
    requires { w.leader[h] }
    requires { valid n }
    ensures  { not (crash w h).leader[n] }
  =
    if n = h then
      assert { (crash w h).leader[n] = false }
    else begin
      assert { not w.leader[n] };
      assert { (crash w h).leader[n] = w.leader[n] }
    end

  (* se o líder h falha, então depois do crash não há líder *)
  let lemma leaderCrashRemovesLeader (w:world) (h:node)
    requires { inv w }
    requires { crash_enbld w h }
    requires { w.leader[h] }
    ensures  { no_leader (crash w h) }
  =
    assert { forall n : node.
      valid n -> not (crash w h).leader[n] }

  goal timeoutCreatesSuspicion :
    forall w : world, h : node.
      timeout_suspect_enbld w h -> (timeout_suspect w h).suspect[h]

  goal suspectedAliveProcessCanStartElection :
    forall w : world, h : node.
      valid h -> w.alive[h] -> w.suspect[h] ->
      (w.st[h] = Idle \/ w.st[h] = Normal \/ w.st[h] = Waiting) ->
      start_election_enbld w h

  goal onlyCurrentMaxCanBecomeLeader :
    forall w : world, h : node.
      become_leader_enbld w h -> is_max_alive w h

  goal maxAliveCanBecomeLeaderWhenElectingAndNoLeader :
    forall w : world, h : node.
      is_max_alive w h -> no_leader w -> w.st[h] = Electing ->
      become_leader_enbld w h

  goal becomeLeaderCreatesLeader :
    forall w : world, h : node.
      become_leader_enbld w h -> (become_leader w h).leader[h]

  goal maxAliveElectingHasLeaderSuccessor :
    forall w : world, h : node.
      is_max_alive w h -> no_leader w -> w.st[h] = Electing ->
      exists w' : world. step w w' /\ w'.leader[h]

  goal noLeaderAndAliveCanSuspect :
    forall w : world, h : node.
      no_leader w -> valid h -> w.alive[h] -> not w.leader[h] ->
      timeout_suspect_enbld w h

  goal noLeaderAliveCanReachElectionStartLocally :
    forall w : world, h : node.
      no_leader w -> valid h -> w.alive[h] ->
      (start_election_enbld (timeout_suspect w h) h \/
       (timeout_suspect w h).suspect[h])

  goal leaderCanSendHeartbeat :
    forall w : world, h d : node.
      valid h -> valid d -> h <> d ->
      w.alive[h] -> w.alive[d] -> w.leader[h] ->
      send_heartbeat_enbld w h d

  goal leaderCanSendCoordinator :
    forall w : world, h d : node.
      valid h -> valid d -> w.alive[h] -> w.alive[d] ->
      w.leader[h] -> id d < id h ->
      send_coord_enbld w h d

end
