(* Dynamic abstract leader election.

   Contribution by:
     João Gonçalves, Carlos Pina

   The most abstract machine of the dynamic leader-election chain.  It
   records only which processes are alive and which process is leader --
   no process IDs, no messages, no timing.

   State     aliveAbs, isLeader
   Actions   crash        a process fails; if it was leader it stops being one
             recover      a dead process comes back, and may clear the leader
                          flag of one process l in the same step
             elect        any alive process becomes leader, if there is none
   Invariant a leader is alive; there is at most one leader

   Limitations
     - Election is unconstrained beyond "there is currently no leader".
       The greatest-ID rule is introduced by the refining machine.
     - Recovery and deposition happen in a single step.  This is an
       atomicity choice standing in for "a returning process forces a new
       election and the incumbent stands down"; the machine cannot express
       the interval during which a displaced leader has not yet learned.
       Taking l = h gives recovery that deposes nobody.
     - Safety only.  Nothing here states that an election ever occurs, or
       that a leaderless system stays leaderless for a bounded time.

*)


module LeaderElectDynamicFull

  use int.Int
  use map.Map

  type node = int

  val constant n_nodes : int
  axiom n_nodes_ax : 2 <= n_nodes

  predicate valid (n:node) =
    0 <= n < n_nodes

  type world = {
    aliveAbs : map node bool;
    isLeader : map node bool;
  }

  predicate no_leader (w:world) =
    forall n : node. valid n -> not w.isLeader[n]

  predicate inv (w:world) =
    (forall i : node.
       valid i -> w.isLeader[i] -> w.aliveAbs[i])
    /\
    (forall i j : node.
       valid i -> valid j ->
       w.isLeader[i] -> w.isLeader[j] -> i = j)

  predicate initWorld_p (w:world) =
    (forall n : node. valid n -> w.aliveAbs[n] = true)
    /\
    (forall n : node. valid n -> w.isLeader[n] = false)

  let ghost predicate initWorld (w:world)
    ensures { result -> inv w }
  = initWorld_p w

  (* A process may fail dynamically.  If it was leader, it stops being leader. *)
  predicate crash_enbld (w:world) (h:node) =
    valid h /\ w.aliveAbs[h]

  let ghost function crash (w:world) (h:node) : world
    requires { crash_enbld w h }
    ensures  { inv w -> inv result }
  =
    { aliveAbs = w.aliveAbs[h <- false];
      isLeader = w.isLeader[h <- false] }

  (* Recovery, with no restriction on h.  The recovering process may
     displace one incumbent l in the same step; see the revision note. *)
  predicate recover_enbld (w:world) (h:node) (l:node) =
    valid h /\ not w.aliveAbs[h] /\ valid l

  let ghost function recover (w:world) (h:node) (l:node) : world
    requires { recover_enbld w h l }
    ensures  { inv w -> inv result }
  =
    { aliveAbs = w.aliveAbs[h <- true];
      isLeader = w.isLeader[l <- false] }

  (* Abstract election: if there is no leader, any alive process may become
     leader.  The max-alive restriction is introduced in the intermediate
     machine. *)
  predicate elect_enbld (w:world) (h:node) =
    valid h /\ w.aliveAbs[h] /\ no_leader w

  let ghost function elect (w:world) (h:node) : world
    requires { elect_enbld w h }
    ensures  { inv w -> inv result }
  =
    { aliveAbs = w.aliveAbs;
      isLeader = w.isLeader[h <- true] }

  inductive stepind world world =
  | step_crash : forall w : world, h : node.
      crash_enbld w h -> stepind w (crash w h)
  | step_recover : forall w : world, h l : node.
      recover_enbld w h l -> stepind w (recover w h l)
  | step_elect : forall w : world, h : node.
      elect_enbld w h -> stepind w (elect w h)

  let ghost predicate step (w1:world) (w2:world)
    ensures { result -> inv w1 -> inv w2 }
  = stepind w1 w2

  clone export inductiveness.Inductiveness with
    type world,
    predicate inv,
    val step,
    val initWorld

  goal leaderIsAlive :
    forall w : world, i : node.
      reachable w -> valid i -> w.isLeader[i] -> w.aliveAbs[i]

  goal uniqueLeader :
    forall w : world, i j : node.
      reachable w -> valid i -> valid j ->
      w.isLeader[i] -> w.isLeader[j] -> i = j

end
