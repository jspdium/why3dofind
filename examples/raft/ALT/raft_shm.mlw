(* ============================================================
   Raft leader election — shared-memory model.

   Contribution by:
     Ana Sá Oliveira, Edgar Araújo, Gabriel Paiva

   Adapted to the why3do refinement framework.

   Election only: no logs, no log replication, no commit index.
   Soliciting a vote and granting it are one atomic action, so there is
   no message layer; raft_msg models the queues.

   State     cur_term        per-node current term
             role            Follower | Candidate | Leader
             vote_term       term of the node's current vote (-1 = none)
             voted_for       who it voted for in vote_term
             votes           ghost: votes[v,c,t] = v voted for c in term t
             elected_leader  ghost: the node elected in each term
             elected_quorum  ghost: the quorum that elected it

   Actions   timeout       become Candidate at term+1, voting for self
             requestVote   a Candidate takes a vote from a node whose term
                           is no higher and which has not voted in that
                           term; the voter adopts the term and reverts to
                           Follower
             becomeLeader  a Candidate holding a quorum becomes Leader and
                           is recorded in the ledger for its term

   Invariant terms and vote terms are in range; a vote's term never
             exceeds the voter's current term; the ghost votes map and the
             concrete vote_term / voted_for fields agree in both
             directions; a node votes at most once per term; voted_for is
             a valid node; a recorded election is backed by a quorum of
             ghost votes; and a Leader is the node recorded for its
             current term.

   Election safety is stated over the ledger rather than over roles, so it
   does not depend on a leader keeping its role.  That is what allows
   requestVote to demote a Leader and raise its term, as Raft does.  Role
   level uniqueness then follows: two Leaders at the same term would both
   be the node recorded for it.

   Limitations
     - Quorums are abstract.  member is uninterpreted and quorum_overlap
       is an assumption, not the pigeonhole principle: nothing relates
       quorums to majorities, and no cardinality is available.  The axiom
       is load-bearing in a way its name does not suggest, since it also
       forces every quorum non-empty -- without that, becomeLeader's
       "forall v. member v q -> ..." would hold vacuously for an empty q
       and any Candidate could win with no votes.
     - A vote request to a node with a strictly higher term is modelled as
       simply not enabled, rather than as an explicit rejection.  At this
       abstraction there is no queue for a refused request to block.
     - A Leader is never told that it has been superseded; it stays a
       Leader at its old term until some Candidate takes its vote.  Two
       nodes may therefore hold the Leader role at once, at different
       terms, which is what Raft actually permits.
     - Safety only.  candidateWithQuorumIsElected is a one-step witness;
       nothing shows that a quorum is ever accumulated, so election is not
       shown reachable.  quorum_overlap does at least rule out the
       degenerate reading in which no quorum exists.
     - n_nodes is fixed; nodes never crash or restart.
   ============================================================ *)

module Raft

  use int.Int
  use map.Map
  use map.Const
  use option.Option

  type node = int

  type role = Follower | Candidate | Leader

  val constant n_nodes : int
  axiom n_nodes_pos : n_nodes >= 2

  predicate valid_node (i : node) = 0 <= i < n_nodes

  (* ===========================================================
     ABSTRACT QUORUMS
     =========================================================== *)

  type quorum
  predicate member node quorum

  (* Used only to initialise the ghost quorum map. *)
  val constant default_quorum : quorum

  axiom quorum_validity :
    forall q : quorum, v : node. member v q -> valid_node v

  (* Assumed, not derived: any two quorums share a member.  A concrete
     majority-based instantiation would satisfy this, but no such
     instantiation is carried out here. *)
  axiom quorum_overlap :
    forall q1 q2 : quorum.
      exists i : node. valid_node i /\ member i q1 /\ member i q2

  (* ===========================================================
     WORLD STATE
     =========================================================== *)

  type world = {
    cur_term       : map node int;
    role           : map node role;
    vote_term      : map node int;
    voted_for      : map node node;
    votes          : map (node, node, int) bool;
    elected_leader : map int (option node);
    elected_quorum : map int quorum;
  }

  (* ===========================================================
     INDUCTIVE INVARIANT
     =========================================================== *)

  predicate inv_sanity (w : world) =
    forall i : node. valid_node i ->
      w.cur_term[i] >= 0 /\ w.vote_term[i] >= -1

  predicate inv_vote_le_term (w : world) =
    forall i : node. valid_node i -> w.vote_term[i] <= w.cur_term[i]

  (* Ghost to concrete: a recorded vote is reflected in the voter's
     fields. *)
  predicate inv_vote_recorded (w : world) =
    forall v c : node. forall t : int.
      valid_node v -> valid_node c -> t >= 0 -> w.votes[(v, c, t)] ->
        w.vote_term[v] >= t /\ (w.vote_term[v] = t -> w.voted_for[v] = c)

  (* Concrete to ghost: the voter's current vote appears in the map. *)
  predicate inv_current_vote_in_map (w : world) =
    forall v : node. valid_node v -> w.vote_term[v] >= 0 ->
      w.votes[(v, w.voted_for[v], w.vote_term[v])]

  predicate inv_vote_once (w : world) =
    forall v c1 c2 : node. forall t : int.
      valid_node v -> valid_node c1 -> valid_node c2 -> t >= 0 ->
        w.votes[(v, c1, t)] -> w.votes[(v, c2, t)] -> c1 = c2

  predicate inv_voted_for_valid (w : world) =
    forall v : node. valid_node v -> w.vote_term[v] >= 0 ->
      valid_node w.voted_for[v]

  (* The ledger is backed by real votes. *)
  predicate inv_ledger (w : world) =
    forall t : int, ldr : node.
      w.elected_leader[t] = Some ldr ->
        valid_node ldr /\
        (forall v : node. member v w.elected_quorum[t] ->
           w.votes[(v, ldr, t)])

  (* A Leader is the node recorded for its current term.  This is what
     transfers ledger uniqueness to the role level. *)
  predicate inv_leader_elected (w : world) =
    forall i : node. valid_node i -> w.role[i] = Leader ->
      w.elected_leader[w.cur_term[i]] = Some i

  predicate inv (w : world) =
    inv_sanity              w /\
    inv_vote_le_term        w /\
    inv_vote_recorded       w /\
    inv_current_vote_in_map w /\
    inv_vote_once           w /\
    inv_voted_for_valid     w /\
    inv_ledger              w /\
    inv_leader_elected      w

  (* ===========================================================
     INITIAL WORLD
     =========================================================== *)

  predicate initWorld_p (w : world) =
    w.cur_term       = const 0              /\
    w.role           = const Follower       /\
    w.vote_term      = const (-1)           /\
    w.voted_for      = const 0              /\
    w.votes          = const false          /\
    w.elected_leader = const None           /\
    w.elected_quorum = const default_quorum

  let ghost predicate initWorld (w : world)
    ensures { result -> inv w }
  = initWorld_p w

  (* ===========================================================
     ACTIONS

     These use `requires { inv w } / ensures { inv result }` rather than
     the repository's `ensures { inv w -> inv result }`, because
     becomeLeader needs inv as a hypothesis for its inline proof script.
     =========================================================== *)

  (* A1. Timeout.  Enabled in any role: now that safety is ledger-based,
         excluding Leader would buy nothing. *)
  predicate timeout_enbld (w : world) (i : node) =
    valid_node i

  let ghost function timeout (w : world) (i : node) : world
    requires { inv w }
    requires { timeout_enbld w i }
    ensures  { inv result }
  =
    let t = w.cur_term[i] + 1 in
    { w with
      cur_term  = w.cur_term [i <- t];
      role      = w.role     [i <- Candidate];
      vote_term = w.vote_term[i <- t];
      voted_for = w.voted_for[i <- i];
      votes     = w.votes[(i, i, t) <- true];
    }

  (* A2. A Candidate takes j's vote.  j adopts the term and reverts to
         Follower, which is Raft's term rule and is what lets a stale
         Leader be demoted. *)
  predicate requestVote_enbld (w : world) (i j : node) =
    valid_node i /\ valid_node j /\ i <> j /\
    w.role[i] = Candidate /\
    w.vote_term[j] < w.cur_term[i] /\
    w.cur_term[j] <= w.cur_term[i]

  let ghost function requestVote (w : world) (i j : node) : world
    requires { inv w }
    requires { requestVote_enbld w i j }
    ensures  { inv result }
  =
    let t = w.cur_term[i] in
    { w with
      cur_term  = w.cur_term [j <- t];
      role      = w.role     [j <- Follower];
      vote_term = w.vote_term[j <- t];
      voted_for = w.voted_for[j <- i];
      votes     = w.votes[(j, i, t) <- true];
    }

  (* A3. A Candidate holding a quorum wins and is recorded in the ledger.
         If the term already has a recorded leader it must be this node,
         which is where quorum overlap and vote uniqueness are used. *)
  predicate becomeLeader_enbld (w : world) (i : node) (q : quorum) =
    valid_node i /\
    w.role[i] = Candidate /\
    (forall v : node. member v q -> w.votes[(v, i, w.cur_term[i])])

  let ghost function becomeLeader (w : world) (i : node) (q : quorum) : world
    requires { inv w }
    requires { becomeLeader_enbld w i q }
    ensures  { inv result }
  =
    let t = w.cur_term[i] in
    match w.elected_leader[t] with
    | Some j ->
        assert { valid_node j };
        assert { forall v : node.
                   member v w.elected_quorum[t] -> w.votes[(v, j, t)] };
        assert { exists v : node.
                   valid_node v /\ member v q /\ member v w.elected_quorum[t] };
        assert { exists v : node.
                   valid_node v /\ w.votes[(v, i, t)] /\ w.votes[(v, j, t)] };
        assert { i = j };
        { w with role = w.role[i <- Leader] }
    | None ->
        { w with
          role           = w.role[i <- Leader];
          elected_leader = w.elected_leader[t <- Some i];
          elected_quorum = w.elected_quorum[t <- q];
        }
    end

  (* ===========================================================
     TRANSITION RELATION
     =========================================================== *)

  inductive stepind world world =
    | step_timeout :
        forall w i. timeout_enbld w i -> stepind w (timeout w i)
    | step_requestVote :
        forall w i j. requestVote_enbld w i j -> stepind w (requestVote w i j)
    | step_becomeLeader :
        forall w i q. becomeLeader_enbld w i q ->
          stepind w (becomeLeader w i q)

  let ghost predicate step (w1 w2 : world) = stepind w1 w2

  clone export inductiveness.Inductiveness with
    type world,
    predicate inv,
    val step,
    val initWorld

  (* ===========================================================
     SAFETY
     =========================================================== *)

  (* Election safety over the ledger.  The option type makes this
     structural; the content is that becomeLeader can never overwrite a
     different entry, which is discharged in its Some branch. *)
  goal electionSafety :
    forall w : world, t : int, i j : node. reachable w ->
      w.elected_leader[t] = Some i -> w.elected_leader[t] = Some j -> i = j

  (* Role-level uniqueness, now a consequence rather than an artifact of
     leadership being permanent. *)
  goal leaderUniquePerTerm :
    forall w : world, i j : node. reachable w ->
      valid_node i -> valid_node j ->
      w.role[i] = Leader -> w.role[j] = Leader ->
      w.cur_term[i] = w.cur_term[j] ->
      i = j

  goal leaderWasElected :
    forall w : world, i : node. reachable w -> valid_node i ->
      w.role[i] = Leader -> w.elected_leader[w.cur_term[i]] = Some i

  (* Stated over reachable states, not over inv. *)
  goal voteOncePerTerm :
    forall w : world, v c1 c2 : node, t : int. reachable w ->
      valid_node v -> valid_node c1 -> valid_node c2 -> t >= 0 ->
      w.votes[(v, c1, t)] -> w.votes[(v, c2, t)] -> c1 = c2

  goal electedLeaderHasQuorum :
    forall w : world, t : int, ldr : node. reachable w ->
      w.elected_leader[t] = Some ldr ->
      exists q : quorum. forall v : node.
        member v q -> w.votes[(v, ldr, t)]

  goal termMonotonic :
    forall w1 w2 : world. step w1 w2 ->
      forall n : node. valid_node n -> w1.cur_term[n] <= w2.cur_term[n]

  (* One-step witness.  The ledger conclusion needs the invariant, so
     this is not just the guard restated. *)
  goal candidateWithQuorumIsElected :
    forall w : world, i : node, q : quorum. reachable w ->
      valid_node i -> w.role[i] = Candidate ->
      (forall v : node. member v q -> w.votes[(v, i, w.cur_term[i])]) ->
      exists w' : world. step w w'
        /\ w'.role[i] = Leader
        /\ w'.elected_leader[w'.cur_term[i]] = Some i

end
