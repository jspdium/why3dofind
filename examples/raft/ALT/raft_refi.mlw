(* ============================================================
   Raft leader election — network model refining an abstract election
   ledger.

   Contribution by:
     Ana Sá Oliveira, Edgar Araújo, Gabriel Paiva

   Adapted to the why3do refinement framework.

   Two machines.  AbstractElection records, per term, which node was
   elected; an abstract step may fill an empty term or re-affirm the node
   already there, never overwrite a different one.  Raft adds terms,
   votes, a network, and refines it.

   Abstract state  leaders : map int (option node)

   Concrete state  cur_term, role, vote_term, voted_for
                   net_req_vote      requests ever sent, by (src,dst,term)
                   net_vote_granted  grants ever sent, by (voter,cand,term)
                   votes             ghost vote history
                   elected_leader    ghost per-term election ledger
                   elected_quorum    ghost quorum that elected each leader

   Actions   timeout        become Candidate at term+1, self-vote, and
                            post the self-grant
             send_ReqVote   a Candidate posts a request for its term
             handle_ReqVote a node with a real request at term t, and no
                            vote in t, adopts t, reverts to Follower and
                            posts a grant
             becomeLeader   a Candidate whose posted grants form a quorum
                            becomes Leader and is recorded in the ledger

   Concrete invariant  terms and vote terms in range; vote terms bounded
             by current terms; the ghost votes map and the concrete vote
             fields agree in both directions; one vote per voter per term;
             voted_for valid; every posted grant is a real vote; the
             ledger is backed by a quorum of votes; a Leader is the node
             recorded for its current term.

   Abstract invariant  trivially true: one-leader-per-term is enforced by
             the state type, since map int (option node) cannot hold two
             nodes for one term, and the rest is enforced by the abstract
             step guard.  So the refinement transfers no abstract
             invariant; all of its content is in the step simulation,
             which is where becomeLeader has to prove that it is not
             overwriting a different leader.

   Limitations
     - Quorums are abstract.  member is uninterpreted and quorum_overlap
       is an assumption, not the pigeonhole principle: nothing relates
       quorums to majorities.  The axiom also forces quorums non-empty,
       which becomeLeader relies on.
     - The network is a monotone record of messages ever sent, not a
       channel: nothing is consumed, delivery is idempotent, and a posted
       grant persists for ever.  This models arbitrary delay and
       duplication with no loss, and it is coarser than raft_msg's FIFO
       inboxes.  No refinement between the two models is claimed.
     - handle_ReqVote's guard requires cur_term[i] <= t, so a request
       older than the recipient's term is modelled as not enabled rather
       than as an explicit rejection.  Since nothing is consumed there is
       no queue for it to block.
     - A Leader is never told it has been superseded; it holds the role at
       its old term until some Candidate takes its vote.  Two nodes may
       hold the Leader role at once at different terms, which is what
       Raft permits.
     - Safety only.  candidateWithQuorumIsElected is a one-step witness;
       nothing shows a quorum is ever accumulated, so election is not
       shown reachable.
     - n_nodes is fixed; nodes never crash or restart.
   ============================================================ *)

module AbstractElection

  use int.Int
  use option.Option
  use map.Map
  use map.Const

  type node = int

  type abs_world = {
    leaders : map int (option node);
  }

  (* Trivially true; see the header note. *)
  predicate invA (_aw : abs_world) = true

  predicate initWorldA_p (aw : abs_world) =
    aw.leaders = const None

  let ghost predicate initWorldA (aw : abs_world)
    ensures { result -> invA aw }
  = initWorldA_p aw

  (* An election may fill an empty term or re-affirm the node already
     recorded, never replace it with a different one. *)
  predicate elect_enbld (aw : abs_world) (t : int) (ldr : node) =
    t >= 0 /\ (aw.leaders[t] = None \/ aw.leaders[t] = Some ldr)

  let ghost function elect (aw : abs_world) (t : int) (ldr : node) : abs_world
    requires { elect_enbld aw t ldr }
    ensures  { invA aw -> invA result }
  = { leaders = aw.leaders[t <- Some ldr] }

  inductive stepAind abs_world abs_world =
    | step_elect : forall aw : abs_world, t : int, ldr : node.
        elect_enbld aw t ldr -> stepAind aw (elect aw t ldr)

  let ghost predicate stepA (aw1 aw2 : abs_world) = stepAind aw1 aw2

end


module Raft

  use int.Int
  use map.Map
  use map.Const
  use option.Option
  use AbstractElection

  type role = Follower | Candidate | Leader

  val constant n_nodes : int
  axiom n_nodes_pos : n_nodes >= 2
  predicate valid_node (i : node) = 0 <= i < n_nodes

  type quorum
  predicate member node quorum
  val constant default_quorum : quorum

  axiom quorum_validity :
    forall q : quorum, v : node. member v q -> valid_node v

  (* Assumed, not derived; also the source of quorum non-emptiness. *)
  axiom quorum_overlap :
    forall q1 q2 : quorum.
      exists i : node. valid_node i /\ member i q1 /\ member i q2

  type world = {
    cur_term         : map node int;
    role             : map node role;
    vote_term        : map node int;
    voted_for        : map node node;
    net_req_vote     : map (node, node, int) bool;
    net_vote_granted : map (node, node, int) bool;
    votes            : map (node, node, int) bool;
    elected_leader   : map int (option node);
    elected_quorum   : map int quorum;
  }

  let ghost function refn (w : world) : abs_world =
    { leaders = w.elected_leader }

  lemma refn_leaders :
    forall w : world, t : int. (refn w).leaders[t] = w.elected_leader[t]

  (* ===========================================================
     INVARIANT
     =========================================================== *)

  predicate inv_sanity (w : world) =
    forall i : node. valid_node i -> w.cur_term[i] >= 0 /\ w.vote_term[i] >= -1

  predicate inv_vote_le_term (w : world) =
    forall i : node. valid_node i -> w.vote_term[i] <= w.cur_term[i]

  predicate inv_vote_recorded (w : world) =
    forall v c : node. forall t : int.
      valid_node v -> valid_node c -> t >= 0 -> w.votes[(v, c, t)] ->
        w.vote_term[v] >= t /\ (w.vote_term[v] = t -> w.voted_for[v] = c)

  predicate inv_current_vote_in_map (w : world) =
    forall v : node. valid_node v -> w.vote_term[v] >= 0 ->
      w.votes[(v, w.voted_for[v], w.vote_term[v])]

  predicate inv_vote_once (w : world) =
    forall v c1 c2 : node. forall t : int.
      valid_node v -> valid_node c1 -> valid_node c2 -> t >= 0 ->
        w.votes[(v, c1, t)] -> w.votes[(v, c2, t)] -> c1 = c2

  predicate inv_voted_for_valid (w : world) =
    forall v : node. valid_node v -> w.vote_term[v] >= 0 ->
      valid_node w.voted_for[v]

  (* Nothing is posted to the network that is not a real vote. *)
  predicate inv_network_votes (w : world) =
    forall v c : node. forall t : int.
      valid_node v -> valid_node c -> t >= 0 ->
        w.net_vote_granted[(v, c, t)] -> w.votes[(v, c, t)]

  predicate inv_ledger (w : world) =
    forall t : int, ldr : node.
      w.elected_leader[t] = Some ldr ->
        valid_node ldr /\
        (forall v : node. member v w.elected_quorum[t] -> w.votes[(v, ldr, t)])

  predicate inv_leader_elected (w : world) =
    forall i : node. valid_node i -> w.role[i] = Leader ->
      w.elected_leader[w.cur_term[i]] = Some i

  predicate invC (w : world) =
    inv_sanity              w /\
    inv_vote_le_term        w /\
    inv_vote_recorded       w /\
    inv_current_vote_in_map w /\
    inv_vote_once           w /\
    inv_voted_for_valid     w /\
    inv_network_votes       w /\
    inv_ledger              w /\
    inv_leader_elected      w

  (* ===========================================================
     INITIAL STATE
     =========================================================== *)

  predicate initWorldC_p (w : world) =
    w.cur_term         = const 0              /\
    w.role             = const Follower       /\
    w.vote_term        = const (-1)           /\
    w.voted_for        = const 0              /\
    w.net_req_vote     = const false          /\
    w.net_vote_granted = const false          /\
    w.votes            = const false          /\
    w.elected_leader   = const None           /\
    w.elected_quorum   = const default_quorum

  let ghost predicate initWorldC (w : world)
    ensures { result -> invC w }
    ensures { result -> AbstractElection.initWorldA (refn w) }
  = initWorldC_p w

  (* ===========================================================
     ACTIONS
     =========================================================== *)

  (* A1. Timeout.  Enabled in any role: safety is ledger-based, so
         excluding Leader would buy nothing. *)
  predicate timeout_enbld (w : world) (i : node) =
    valid_node i

  let ghost function timeout (w : world) (i : node) : world
    requires { invC w }
    requires { timeout_enbld w i }
    ensures  { invC result }
    ensures  { refn result = refn w }
  = let t = w.cur_term[i] + 1 in
    { w with
      cur_term         = w.cur_term[i <- t];
      role             = w.role[i <- Candidate];
      vote_term        = w.vote_term[i <- t];
      voted_for        = w.voted_for[i <- i];
      votes            = w.votes[(i, i, t) <- true];
      net_vote_granted = w.net_vote_granted[(i, i, t) <- true];
    }

  (* A2. A Candidate posts a vote request for its own term. *)
  predicate send_ReqVote_enbld (w : world) (i j : node) =
    valid_node i /\ valid_node j /\ i <> j /\ w.role[i] = Candidate

  let ghost function send_ReqVote (w : world) (i j : node) : world
    requires { invC w }
    requires { send_ReqVote_enbld w i j }
    ensures  { invC result }
    ensures  { refn result = refn w }
  = { w with net_req_vote = w.net_req_vote[(i, j, w.cur_term[i]) <- true] }

  (* A3. Handle a real request at term t: adopt t, revert to Follower,
         grant.  The term parameter is tied to an actual send by the
         net_req_vote conjunct, so it cannot be chosen freely. *)
  predicate handle_ReqVote_enbld (w : world) (i j : node) (t : int) =
    valid_node i /\ valid_node j /\ i <> j /\
    w.net_req_vote[(j, i, t)] /\ w.vote_term[i] < t /\ w.cur_term[i] <= t

  let ghost function handle_ReqVote (w : world) (i j : node) (t : int) : world
    requires { invC w }
    requires { handle_ReqVote_enbld w i j t }
    ensures  { invC result }
    ensures  { refn result = refn w }
  =
    assert { forall c : node. valid_node c -> w.votes[(i, c, t)] ->
               w.vote_term[i] >= t };
    assert { forall c : node. valid_node c -> not w.votes[(i, c, t)] };
    { w with
      cur_term         = w.cur_term[i <- t];
      role             = w.role[i <- Follower];
      vote_term        = w.vote_term[i <- t];
      voted_for        = w.voted_for[i <- j];
      votes            = w.votes[(i, j, t) <- true];
      net_vote_granted = w.net_vote_granted[(i, j, t) <- true];
    }

  (* A4. A Candidate whose posted grants form a quorum wins.  If the term
         already has a recorded leader it must be this node -- proved from
         quorum overlap and vote uniqueness -- and the step is a stutter;
         otherwise the ledger grows and the step simulates elect. *)
  predicate becomeLeader_enbld (w : world) (i : node) (q : quorum) =
    valid_node i /\ w.role[i] = Candidate /\
    (forall v : node. member v q -> w.net_vote_granted[(v, i, w.cur_term[i])])

  let ghost function becomeLeader (w : world) (i : node) (q : quorum) : world
    requires { invC w }
    requires { becomeLeader_enbld w i q }
    ensures  { invC result }
    ensures  { refn result = refn w \/ stepA (refn w) (refn result) }
  =
    let t = w.cur_term[i] in
    assert { forall v : node. member v q -> w.votes[(v, i, t)] };
    match w.elected_leader[t] with
    | Some j ->
        assert { valid_node j };
        assert { forall v : node.
                   member v w.elected_quorum[t] -> w.votes[(v, j, t)] };
        assert { exists v : node.
                   valid_node v /\ member v q /\ member v w.elected_quorum[t] };
        assert { exists v : node.
                   valid_node v /\ w.votes[(v, i, t)] /\ w.votes[(v, j, t)] };
        assert { i = j };
        { w with role = w.role[i <- Leader] }
    | None ->
        let w2 = { w with
          role           = w.role[i <- Leader];
          elected_leader = w.elected_leader[t <- Some i];
          elected_quorum = w.elected_quorum[t <- q];
        } in
        assert { elect_enbld (refn w) t i };
        assert { refn w2 = elect (refn w) t i };
        assert { stepA (refn w) (refn w2) };
        w2
    end

  (* ===========================================================
     CONCRETE STEP RELATION
     =========================================================== *)

  inductive stepind world world =
    | step_timeout : forall w : world, i : node.
        timeout_enbld w i -> stepind w (timeout w i)
    | step_send_ReqVote : forall w : world, i j : node.
        send_ReqVote_enbld w i j -> stepind w (send_ReqVote w i j)
    | step_handle_ReqVote : forall w : world, i j : node, t : int.
        handle_ReqVote_enbld w i j t -> stepind w (handle_ReqVote w i j t)
    | step_becomeLeader : forall w : world, i : node, q : quorum.
        becomeLeader_enbld w i q -> stepind w (becomeLeader w i q)

  let ghost predicate stepC (w1 w2 : world) = stepind w1 w2

  clone export refinement.Refinement with
    type worldA      = abs_world,
    type worldC      = world,
    val  refn        = refn,
    predicate invA   = AbstractElection.invA,
    predicate invC   = invC,
    val  initWorldA  = AbstractElection.initWorldA,
    val  initWorldC  = initWorldC,
    val  stepA       = AbstractElection.stepA,
    val  stepC       = stepC

  (* ===========================================================
     SAFETY
     =========================================================== *)

  (* The end-to-end theorems the previous version was missing: everything
     below is stated over reachable states, not over invC. *)

  goal electionSafety :
    forall w : world, t : int, i j : node. reachableC w ->
      w.elected_leader[t] = Some i -> w.elected_leader[t] = Some j -> i = j

  goal leaderUniquePerTerm :
    forall w : world, i j : node. reachableC w ->
      valid_node i -> valid_node j ->
      w.role[i] = Leader -> w.role[j] = Leader ->
      w.cur_term[i] = w.cur_term[j] ->
      i = j

  goal leaderWasElected :
    forall w : world, i : node. reachableC w -> valid_node i ->
      w.role[i] = Leader -> w.elected_leader[w.cur_term[i]] = Some i

  goal voteOncePerTerm :
    forall w : world, v c1 c2 : node, t : int. reachableC w ->
      valid_node v -> valid_node c1 -> valid_node c2 -> t >= 0 ->
      w.votes[(v, c1, t)] -> w.votes[(v, c2, t)] -> c1 = c2

  goal networkGrantsAreRealVotes :
    forall w : world, v c : node, t : int. reachableC w ->
      valid_node v -> valid_node c -> t >= 0 ->
      w.net_vote_granted[(v, c, t)] -> w.votes[(v, c, t)]

  goal electedLeaderHasQuorum :
    forall w : world, t : int, ldr : node. reachableC w ->
      w.elected_leader[t] = Some ldr ->
      exists q : quorum. forall v : node.
        member v q -> w.votes[(v, ldr, t)]

  goal termNonDecreasing :
    forall w1 w2 : world. reachableC w1 -> stepC w1 w2 ->
      forall i : node. valid_node i -> w1.cur_term[i] <= w2.cur_term[i]

  goal voteTermNonDecreasing :
    forall w1 w2 : world. reachableC w1 -> stepC w1 w2 ->
      forall i : node. valid_node i -> w1.vote_term[i] <= w2.vote_term[i]

  goal ledgerAppendOnly :
    forall w1 w2 : world. reachableC w1 -> stepC w1 w2 ->
      forall t : int, ldr : node.
        w1.elected_leader[t] = Some ldr -> w2.elected_leader[t] = Some ldr

  (* One-step witness with content beyond the guard: the ledger
     conclusion needs the invariant. *)
  goal candidateWithQuorumIsElected :
    forall w : world, i : node, q : quorum. reachableC w ->
      valid_node i -> w.role[i] = Candidate ->
      (forall v : node.
         member v q -> w.net_vote_granted[(v, i, w.cur_term[i])]) ->
      exists w' : world. stepC w w'
        /\ w'.role[i] = Leader
        /\ w'.elected_leader[w'.cur_term[i]] = Some i

end
