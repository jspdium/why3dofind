(* ============================================================
   Raft Refinement: Asynchronous Network to Abstract Ledger

   Contribution by:
     Ana Sá Oliveira, Edgar Araújo, Gabriel Paiva
   ============================================================ *)

module AbstractElection
  use int.Int
  use option.Option
  use map.Map
  use map.Const

  type node = int

  type abs_world = {
    leaders : map int (option node);
  }

  predicate invA (_aw : abs_world) = true

  predicate elect (aw1 aw2 : abs_world) (t : int) (ldr : node) =
    t >= 0 /\
    (aw1.leaders[t] = None \/ aw1.leaders[t] = Some ldr) /\
    aw2.leaders = aw1.leaders[t <- Some ldr]

  val ghost predicate initWorldA (aw : abs_world)
    ensures { result <-> aw.leaders = const None }

  val ghost predicate stepA (aw1 aw2 : abs_world)
    ensures { result <-> exists t : int, ldr : node. elect aw1 aw2 t ldr }

end


module Raft

  use int.Int
  use map.Map
  use map.Const
  use option.Option
  use AbstractElection

  type role = Follower | Candidate | Leader

  val constant n_nodes : int
  axiom n_nodes_pos : n_nodes >= 2
  predicate valid_node (i : node) = 0 <= i < n_nodes

  type quorum
  predicate member node quorum
  val constant default_quorum : quorum

  axiom quorum_validity :
    forall q : quorum, v : node. member v q -> valid_node v

  axiom quorum_overlap :
    forall q1 q2 : quorum.
      exists i : node. valid_node i /\ member i q1 /\ member i q2

  type world = {
    cur_term         : map node int;
    role             : map node role;
    vote_term        : map node int;
    voted_for        : map node node;
    net_req_vote     : map (node, node, int) bool;
    net_vote_granted : map (node, node, int) bool;
    votes            : map (node, node, int) bool;
    ldr_quorum       : map node quorum;
    elected_leader   : map int (option node);
    elected_quorum   : map int quorum;
  }

  let ghost function refn (w : world) : abs_world =
    { leaders = w.elected_leader }

  (* ===========================================================
     INVARIANTS
     =========================================================== *)
  predicate inv_sanity (w : world) =
    forall i : node. valid_node i -> w.cur_term[i] >= 0 /\ w.vote_term[i] >= -1

  predicate inv_vote_le_term (w : world) =
    forall i : node. valid_node i -> w.vote_term[i] <= w.cur_term[i]

  predicate inv_votes_concrete (w : world) =
    forall v c : node. forall t : int.
      valid_node v -> valid_node c -> t >= 0 -> w.votes[(v, c, t)] ->
        w.vote_term[v] >= t /\ (w.vote_term[v] = t -> w.voted_for[v] = c)

  predicate inv_vote_once (w : world) =
    forall v c1 c2 : node. forall t : int.
      valid_node v -> valid_node c1 -> valid_node c2 -> t >= 0 ->
        w.votes[(v, c1, t)] -> w.votes[(v, c2, t)] -> c1 = c2

  predicate inv_network_votes (w : world) =
    forall v c : node. forall t : int.
      valid_node v -> valid_node c -> t >= 0 ->
        w.net_vote_granted[(v, c, t)] -> w.votes[(v, c, t)]

  predicate inv_leader_quorum (w : world) =
    forall ldr : node. valid_node ldr -> w.role[ldr] = Leader ->
      (forall v : node. member v w.ldr_quorum[ldr] ->
        w.votes[(v, ldr, w.cur_term[ldr])])

  predicate inv_concrete_votes (w : world) =
    forall v : node. valid_node v -> w.vote_term[v] >= 0 ->
      w.votes[(v, w.voted_for[v], w.vote_term[v])]

  predicate inv_history_ledger (w : world) =
    forall t : int, ldr : node.
      w.elected_leader[t] = Some ldr ->
        valid_node ldr /\
        (forall v : node. member v w.elected_quorum[t] -> w.votes[(v, ldr, t)])

  predicate invC (w : world) =
    inv_sanity w /\ inv_vote_le_term w /\ inv_votes_concrete w /\
    inv_vote_once w /\ inv_network_votes w /\ inv_leader_quorum w /\
    inv_concrete_votes w /\ inv_history_ledger w

  (* ===========================================================
     INITIAL STATE
     =========================================================== *)
  val ghost predicate initWorldC (w : world)
    ensures { result <->
      w.cur_term         = const 0              /\
      w.role             = const Follower       /\
      w.vote_term        = const (-1)           /\
      w.voted_for        = const 0              /\
      w.net_req_vote     = const false          /\
      w.net_vote_granted = const false          /\
      w.votes            = const false          /\
      w.ldr_quorum       = const default_quorum /\
      w.elected_leader   = const None           /\
      w.elected_quorum   = const default_quorum }

  (* ===========================================================
     ACTIONS
     =========================================================== *)
  predicate timeout_enbld (w : world) (i : node) =
    valid_node i /\ (w.role[i] = Follower \/ w.role[i] = Candidate)

  let ghost function timeout (w : world) (i : node) : world
    requires { invC w }
    requires { timeout_enbld w i }
    ensures  { invC result }
    ensures  { refn result = refn w }
  = let t = w.cur_term[i] + 1 in
    { w with
      cur_term         = w.cur_term[i <- t];
      role             = w.role[i <- Candidate];
      vote_term        = w.vote_term[i <- t];
      voted_for        = w.voted_for[i <- i];
      votes            = w.votes[(i, i, t) <- true];
      net_vote_granted = w.net_vote_granted[(i, i, t) <- true];
    }

  predicate send_ReqVote_enbld (w : world) (i j : node) =
    valid_node i /\ valid_node j /\ i <> j /\ w.role[i] = Candidate

  let ghost function send_ReqVote (w : world) (i j : node) : world
    requires { invC w }
    requires { send_ReqVote_enbld w i j }
    ensures  { invC result }
    ensures  { refn result = refn w }
  = { w with net_req_vote = w.net_req_vote[(i, j, w.cur_term[i]) <- true] }

  predicate handle_ReqVote_enbld (w : world) (i j : node) (t : int) =
    valid_node i /\ valid_node j /\ i <> j /\
    w.net_req_vote[(j, i, t)] /\ w.vote_term[i] < t /\ w.cur_term[i] <= t

  let ghost function handle_ReqVote (w : world) (i j : node) (t : int) : world
    requires { invC w }
    requires { handle_ReqVote_enbld w i j t }
    ensures  { invC result }
    ensures  { refn result = refn w }
  =
    assert { forall c : node. valid_node c -> w.votes[(i, c, t)] -> w.vote_term[i] >= t };
    assert { w.vote_term[i] < t };
    assert { forall c : node. valid_node c -> not w.votes[(i, c, t)] };

    let w_next = { w with
      cur_term         = w.cur_term[i <- t];
      role             = w.role[i <- Follower];
      vote_term        = w.vote_term[i <- t];
      voted_for        = w.voted_for[i <- j];
      votes            = w.votes[(i, j, t) <- true];
      net_vote_granted = w.net_vote_granted[(i, j, t) <- true];
    } in

    assert { forall c1 c2 : node. valid_node c1 -> valid_node c2 ->
             w_next.votes[(i, c1, t)] -> w_next.votes[(i, c2, t)] -> c1 = c2 };
    w_next

  predicate becomeLeader_enbld (w : world) (i : node) (q : quorum) =
    valid_node i /\ w.role[i] = Candidate /\
    (forall v : node. member v q -> w.net_vote_granted[(v, i, w.cur_term[i])])

  let ghost function becomeLeader (w : world) (i : node) (q : quorum) : world
    requires { invC w }
    requires { becomeLeader_enbld w i q }
    ensures  { invC result }
    ensures  { refn result = refn w \/ stepA (refn w) (refn result) }
  =
    let t = w.cur_term[i] in
    assert { forall v : node. member v q -> w.votes[(v, i, t)] };

    let new_ldr_map = match w.elected_leader[t] with
      | Some _ -> w.elected_leader
      | None   -> w.elected_leader[t <- Some i]
    end in

    let new_q_map = match w.elected_leader[t] with
      | Some _ -> w.elected_quorum
      | None   -> w.elected_quorum[t <- q]
    end in

    let w2 = { w with
      role           = w.role[i <- Leader];
      ldr_quorum     = w.ldr_quorum[i <- q];
      elected_leader = new_ldr_map;
      elected_quorum = new_q_map;
    } in

  let _ = match w.elected_leader[t] with
    | Some j ->
        let qj = w.elected_quorum[t] in
        assert { exists v : node. valid_node v /\ member v q /\ member v qj };
        assert { forall v : node. valid_node v -> member v q  -> w.votes[(v, i, t)] };
        assert { forall v : node. valid_node v -> member v qj -> w.votes[(v, j, t)] };
        assert { exists v : node. valid_node v /\
                 w.votes[(v, i, t)] /\ w.votes[(v, j, t)] };
        assert { i = j };
        assert { refn w2 = refn w }
    | None ->
        assert { (refn w2).leaders = (refn w).leaders[t <- Some i] };
        assert { elect (refn w) (refn w2) t i };
        assert { stepA (refn w) (refn w2) }
    end in
    w2
  (* ===========================================================
     CONCRETE STEP RELATION
     =========================================================== *)
  val ghost predicate stepC (w1 w2 : world)
    ensures { result <->
      (exists i : node. timeout_enbld w1 i /\ w2 = timeout w1 i) \/
      (exists i j : node. send_ReqVote_enbld w1 i j /\ w2 = send_ReqVote w1 i j) \/
      (exists i j : node, t : int.
        handle_ReqVote_enbld w1 i j t /\ w2 = handle_ReqVote w1 i j t) \/
      (exists i : node, q : quorum.
        becomeLeader_enbld w1 i q /\ w2 = becomeLeader w1 i q) }

  (* ===========================================================
     SAFETY PROPERTIES
     =========================================================== *)

  (* Leader uniqueness at the role level: two nodes in Leader role
     in the same term must be the same node. Proof sketch:
     each leader holds a quorum of votes; quorums overlap; 
     a node votes at most once per term => the overlap node
     witnesses i = j. *)
  lemma leader_uniqueness :
    forall w : world. invC w ->
      forall i j : node. valid_node i -> valid_node j ->
        w.role[i] = Leader -> w.role[j] = Leader ->
        w.cur_term[i] = w.cur_term[j] ->
        i = j

  (* Terms only increase: a single concrete step never lowers
     any node's current term. *)
  lemma term_nondecreasing :
    forall w1 w2 : world. invC w1 -> stepC w1 w2 ->
      forall i : node. valid_node i ->
        w1.cur_term[i] <= w2.cur_term[i]

  (* Vote terms only increase across a step. *)
  lemma vote_term_nondecreasing :
    forall w1 w2 : world. invC w1 -> stepC w1 w2 ->
      forall i : node. valid_node i ->
        w1.vote_term[i] <= w2.vote_term[i]

  (* The elected_leader ledger is append-only: once a term has a
     leader recorded, that entry never changes. *)
  lemma ledger_append_only :
    forall w1 w2 : world. invC w1 -> stepC w1 w2 ->
      forall t : int, ldr : node.
        w1.elected_leader[t] = Some ldr ->
        w2.elected_leader[t] = Some ldr

  (* ===========================================================
     CLONE
     =========================================================== *)
  clone  "refinement".Refinement with
    type worldA      = abs_world,
    type worldC      = world,
    val  refn        = refn,
    predicate invA   = AbstractElection.invA,
    predicate invC   = invC,
    val  initWorldA  = AbstractElection.initWorldA,
    val  initWorldC  = initWorldC,
    val  stepA       = AbstractElection.stepA,
    val  stepC       = stepC

end