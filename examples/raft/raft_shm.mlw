(* ============================================================
   Simplified Raft – no logs, no log replication.

   Contribution by:
     Ana Sá Oliveira, Edgar Araújo, Gabriel Paiva

   Adapted to the why3do refinement framework.

   Based on:
     • raft.tla (Ongaro 2014)  –  structure of state & actions
     • why3do/paxos/voting.mlw –  proof style (ghost votes map,
                                   inductiveness clone, refinement)

   We model only *leader election*:
     timeout       – node becomes Candidate, bumps term, self-votes
     requestVote   – Follower grants vote to Candidate
     becomeLeader  – Candidate with a quorum becomes Leader

   Ghost bookkeeping (following Paxos/voting.mlw):
     votes.(voter, cand, term) – voter granted cand a vote in term

   Safety properties proved
   ────────────────────────
   A.  vote_once    : each node votes for at most one candidate per term
   B.  leader_quorum: a Leader has majority of votes for its term
   C.  leader_unique: at most one Leader per term  (election safety)
   D.  term_monotonic: cur_term never decreases
   ============================================================ *)

module Raft

  use int.Int
  use map.Map
  use map.Const

  (* ===========================================================
     1.  TYPES
     =========================================================== *)

  type node = int

  type role = Follower | Candidate | Leader

  (* ===========================================================
     2.  CONSTANTS
     =========================================================== *)

  val constant n_nodes : int
  axiom n_nodes_pos : n_nodes >= 2

  predicate valid_node (i : node) = 0 <= i < n_nodes

  (* ===========================================================
     3.  ABSTRACT QUORUMS
     =========================================================== *)

  type quorum
  predicate member node quorum

  (* A dummy quorum used strictly to initialize the ghost map *)
  val constant default_quorum : quorum

  (* Pigeonhole principle: any two quorums share at least one node *)
  axiom quorum_overlap :
    forall q1 q2 : quorum.
      exists i : node. valid_node i /\ member i q1 /\ member i q2
      
  (* ===========================================================
     4.  WORLD STATE
     =========================================================== *)

  (* cur_term.(i)      – current term of node i  (0 initially)
      role.(i)          – Follower | Candidate | Leader
      vote_term.(i)     – term for which i has cast a vote  (-1 = never)
      voted_for.(i)     – candidate i voted for  (only valid when
                           vote_term[i] >= 0)
      votes.(v,c,t)     – ghost: v voted for c in term t              
      ldr_quorum.(i)    – ghost: the quorum that elected i as Leader  *)

  type world = {
    cur_term      : map node int;
    role          : map node role;
    vote_term     : map node int;
    voted_for     : map node node;
    votes         : map (node, node, int) bool;
    ldr_quorum    : map node quorum;
  }

  (* ===========================================================
     5.  INITIAL WORLD
     =========================================================== *)

  predicate initWorld_p (w : world) =
    w.cur_term      = const 0              /\
    w.role          = const Follower       /\
    w.vote_term     = const (-1)           /\
    w.voted_for     = const 0              /\
    w.votes         = const false          /\
    w.ldr_quorum    = const default_quorum

  let ghost predicate initWorld (w : world) = initWorld_p w

  (* ===========================================================
     6.  INDUCTIVE INVARIANT
     =========================================================== *)

  (* Inv-1  basic sanity bounds *)
  predicate inv_sanity (w : world) =
    forall i : node. valid_node i ->
      w.cur_term[i]      >= 0  /\
      w.vote_term[i]     >= -1

  (* Inv-2  vote_term bounded by cur_term *)
  predicate inv_vote_le_term (w : world) =
    forall i : node. valid_node i ->
      w.vote_term[i] <= w.cur_term[i]

  (* Inv-3  ghost consistency:
        if votes.(v,c,t) then v's concrete fields record exactly that vote *)
  predicate inv_votes_concrete (w : world) =
    forall v c : node. forall t : int.
      valid_node v -> valid_node c -> t >= 0 ->
        w.votes[(v, c, t)] ->
          w.vote_term[v] >= t /\
          (w.vote_term[v] = t -> w.voted_for[v] = c)

  (* Inv-4  vote uniqueness per voter (each voter votes once per term) *)
  predicate inv_vote_once (w : world) =
    forall v c1 c2 : node. forall t : int.
      valid_node v -> valid_node c1 -> valid_node c2 -> t >= 0 ->
        w.votes[(v, c1, t)] -> w.votes[(v, c2, t)] ->
          c1 = c2

  (* Inv-5  Leader quorum: a Leader's saved ghost quorum voted for it *)
  predicate inv_leader_quorum (w : world) =
    forall ldr : node. valid_node ldr ->
      w.role[ldr] = Leader ->
        (forall v : node. member v w.ldr_quorum[ldr] -> w.votes[(v, ldr, w.cur_term[ldr])])

  (* Inv-6  if a voter v has voted (vote_term[v] >= 0), there is a ghost vote *)
  predicate inv_concrete_votes (w : world) =
    forall v : node. valid_node v ->
      w.vote_term[v] >= 0 ->
        w.votes[(v, w.voted_for[v], w.vote_term[v])]

  (* Full inductive invariant *)
  predicate inv (w : world) =
    inv_sanity         w /\
    inv_vote_le_term   w /\
    inv_votes_concrete w /\
    inv_vote_once      w /\
    inv_leader_quorum  w /\
    inv_concrete_votes w

  (* ===========================================================
     7.  ACTIONS
     =========================================================== *)

  predicate timeout_enbld (w : world) (i : node) =
    valid_node i /\
    (w.role[i] = Follower \/ w.role[i] = Candidate)

  let ghost function timeout (w : world) (i : node) : world
    requires { timeout_enbld w i }
    ensures  { inv w -> inv result }
  =
    let t = w.cur_term[i] + 1 in
    { w with
      cur_term      = w.cur_term     [i <- t];
      role          = w.role         [i <- Candidate];
      vote_term     = w.vote_term    [i <- t];
      voted_for     = w.voted_for    [i <- i];
      votes         = w.votes[(i, i, t) <- true];
    }

  predicate requestVote_enbld (w : world) (i j : node) =
    valid_node i /\ valid_node j /\ i <> j /\
    w.role[i] = Candidate /\
    w.role[j] = Follower  /\
    w.vote_term[j] < w.cur_term[i] /\
    w.cur_term[j] <= w.cur_term[i]

  let ghost function requestVote (w : world) (i j : node) : world
    requires { requestVote_enbld w i j }
    ensures  { inv w -> inv result }
  =
    let t = w.cur_term[i] in
    { w with
      cur_term      = w.cur_term     [j <- t];
      vote_term     = w.vote_term    [j <- t];
      voted_for     = w.voted_for    [j <- i];
      votes         = w.votes[(j, i, t) <- true];
    }

  predicate becomeLeader_enbld (w : world) (i : node) (q : quorum) =
    valid_node i /\
    w.role[i] = Candidate /\
    (forall v : node. member v q -> w.votes[(v, i, w.cur_term[i])])

  let ghost function becomeLeader (w : world) (i : node) (q : quorum) : world
    requires { becomeLeader_enbld w i q }
    ensures  { inv w -> inv result }
  =
    { w with 
      role       = w.role[i <- Leader];
      ldr_quorum = w.ldr_quorum[i <- q];
    }

  (* ===========================================================
     8.  TRANSITION RELATION
     =========================================================== *)

  inductive stepind world world =
    | step_timeout :
        forall w i. timeout_enbld w i ->
          stepind w (timeout w i)
    | step_requestVote :
        forall w i j. requestVote_enbld w i j ->
          stepind w (requestVote w i j)
    | step_becomeLeader :
      forall w i q. becomeLeader_enbld w i q ->
        stepind w (becomeLeader w i q)

  let ghost predicate step (w1 w2 : world) = stepind w1 w2

  (* ===========================================================
     9.  INDUCTIVENESS
     =========================================================== *)

  clone export inductiveness.Inductiveness with
    type world,
    predicate inv,
    val step,
    val initWorld

(* ===========================================================
     10. SAFETY THEOREMS
     =========================================================== *)

  (* A. Every node votes for at most one candidate per term *)
  lemma vote_once :
    forall w : world. inv w ->
    forall v c1 c2 : node. forall t : int.
      valid_node v -> valid_node c1 -> valid_node c2 -> t >= 0 ->
        w.votes[(v, c1, t)] -> w.votes[(v, c2, t)] ->
          c1 = c2

  (* B. A Leader has a majority of votes *)
  lemma leader_quorum :
    forall w : world. inv w ->
    forall ldr : node. valid_node ldr ->
      w.role[ldr] = Leader ->
        exists q : quorum. forall v : node.
          member v q -> w.votes[(v, ldr, w.cur_term[ldr])]
  
  (* D. Term numbers are monotonically non-decreasing *)
  lemma term_monotonic :
    forall w1 w2 : world. step w1 w2 ->
    forall n : node. valid_node n ->
      w1.cur_term[n] <= w2.cur_term[n]

  (* C. Election safety (Proof Script) 
        We use a 'let lemma' to guide the SMT solver through the pigeonhole 
        principle and vote uniqueness to formally prove leader uniqueness. *)
  let lemma leader_unique_proof (w: world) (i j: node)
    requires { inv w }
    requires { valid_node i /\ valid_node j }
    requires { w.role[i] = Leader }
    requires { w.role[j] = Leader }
    requires { w.cur_term[i] = w.cur_term[j] }
    ensures  { i = j }
  =
    let t = w.cur_term[i] in
    let qi = w.ldr_quorum[i] in
    let qj = w.ldr_quorum[j] in

    assert { inv_leader_quorum w };
    assert { inv_vote_once w };
    assert { forall v: node. member v qi -> w.votes[(v, i, t)] };
    assert { forall v: node. member v qj -> w.votes[(v, j, t)] };
    assert { exists v: node. valid_node v /\ member v qi /\ member v qj };
    assert { exists v: node. valid_node v /\ w.votes[(v, i, t)] /\ w.votes[(v, j, t)] };
    assert { i = j }

(* E. End-to-End Election Safety 
        At most one Leader can be elected per term) *)
  goal election_safety :
    forall w: world. reachable w ->
    forall i j: node.
      valid_node i -> valid_node j ->
        w.role[i] = Leader -> w.role[j] = Leader -> w.cur_term[i] = w.cur_term[j] ->
          i = j
end